<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The assembly keeps its old name: Jellyfin names the plugin's settings file after it, so renaming it would
         leave every existing install without its records and settings. -->
    <AssemblyName>Jellyfin.Plugin.DynamicDns</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.DynamicDns</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.2.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="2026.10.19" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="MaxMind.Db" Version="5.2.0" />
    <!-- SQLite comes from Jellyfin, which ships and initializes it; compiling against the same version. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The proxy runs its own Kestrel host; ASP.NET Core comes from the shared framework Jellyfin loads. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.RemoteAccess.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Admin dashboard pages (tabs) -->
    <EmbeddedResource Include="Configuration\ddns_*.html;Configuration\ddns_*.js;Configuration\ddns_*.css" />
  </ItemGroup>

</Project>
